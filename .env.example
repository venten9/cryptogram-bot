# ==============================================================================
# Cooperative Cryptogram Bot ("Spy and Analyst") Configuration
# Instructions:
# 1. Copy this template to .env:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# 2. Fill in your actual Telegram Bot Token from @BotFather.
# ==============================================================================

# Telegram Bot API Token (obtained from @BotFather)
# Required to start live bot execution with python -m bot.app
# Example: 123456789:ABCdefGhIjkLmNoPqRsTuVwXyZ
BOT_TOKEN=

# Bot username (without '@') used for deep-link invite links (e.g., t.me/<BOT_USERNAME>?start=game_...)
# If left empty, defaults to "SpyAnalystBot"
BOT_USERNAME=SpyAnalystBot

# Async SQLite Database connection URL or path
# Uses aiosqlite for non-blocking asynchronous database operations
# Default: sqlite+aiosqlite:///cryptogram.db
DB_PATH=sqlite+aiosqlite:///cryptogram.db

# Enable verbose debug logging and SQLAlchemy SQL statement echoing (true / false)
DEBUG=false
